# Template for local environment configuration. Copy to `.env` and fill in.
# NEVER commit a filled-in copy — .gitignore covers `.env*` except this file.
#
# Rule of thumb: only values that are safe to publish in the browser bundle
# may carry the NEXT_PUBLIC_ prefix. Everything else is server-only.

# ─── Public Sanity config (safe in the browser) ──────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-28
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# ─── Auth (next-auth v5) ────────────────────────────────────────────────
# Signs and encrypts the JWT session cookie. MUST be a high-entropy random
# value — a guessable one lets anyone forge a session for any customer.
# Generate with:  openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3005

# ─── Sanity tokens (server-only — no NEXT_PUBLIC_ prefix, ever) ──────────
# READ token: required once the dataset is private rather than world
# readable. Grant Viewer/read permission only. Set it on Vercel for
# Production AND Preview (pages render at build time too) BEFORE the
# dataset is switched to Private, or the site and its builds fail.
SANITY_API_READ_TOKEN=
# WRITE token: used by the form endpoints to create documents and upload
# resume assets. Needs create + asset-upload permission.
SANITY_API_WRITE_TOKEN=

# ─── Contact form email (nodemailer / SMTP) ─────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# For Gmail this is an App Password, not the account password.
SMTP_PASS=
# Where contact-form notifications are delivered.
COMPANY_EMAIL=

# ─── Where to Buy leads (/where-to-buy) ──────────────────────────────────
# Visitors leave name, mobile, email, company and consent before any
# outlet is shown. Leads are saved in Sanity (Form Submissions → Where to
# Buy Leads) and emailed via the SMTP settings above, to this inbox when
# set, else COMPANY_EMAIL. AUTH_SECRET signs the 30-day access cookie.
WTB_LEADS_EMAIL=
# Development only: 1 logs leads instead of saving or emailing them.
LEADS_DRY_RUN=

# ─── Mobile verification by SMS code (Firebase phone sign-in) ────────────
# Optional: without these the form takes the mobile unverified. Setup:
#  1. console.firebase.google.com → add a project → add a Web app; copy its
#     apiKey, authDomain and projectId here (safe in the browser).
#  2. Authentication → Sign-in method → enable Phone.
#  3. Authentication → Settings → SMS region policy → allow India only.
#  4. Authentication → Settings → Authorized domains → add
#     pacific-surfaces.com and www.pacific-surfaces.com.
#  5. Upgrade the project to the Blaze plan (SMS is billed per message)
#     and set a budget alert in Google Cloud billing.
#  6. For testing, add fictional test numbers with fixed codes (Phone
#     sign-in → Phone numbers for testing); they send no SMS.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ─── Careers form email (Resend) ────────────────────────────────────────
# All three are optional: without them the application document is still
# created in Sanity, only the email notification is skipped.
RESEND_API_KEY=
CAREERS_FROM_EMAIL=
CAREERS_INBOX_EMAIL=

# ─── Visualizer (Replicate) ─────────────────────────────────────────────
# Powers /api/segment, /api/segment-point, /api/depth, /api/process-surface.
# Every call costs real credit — these routes are rate limited.
REPLICATE_API_TOKEN=
