# Template for local environment configuration. Copy to `.env` and fill in.
# NEVER commit a filled-in copy — .gitignore covers `.env*` except this file.
#
# Rule of thumb: only values that are safe to publish in the browser bundle
# may carry the NEXT_PUBLIC_ prefix. Everything else is server-only.

# ─── Public Sanity config (safe in the browser) ──────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-28
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# ─── Auth (next-auth v5) ────────────────────────────────────────────────
# Signs and encrypts the JWT session cookie. MUST be a high-entropy random
# value — a guessable one lets anyone forge a session for any customer.
# Generate with:  openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3005

# ─── Sanity tokens (server-only — no NEXT_PUBLIC_ prefix, ever) ──────────
# READ token: required once the dataset is private rather than world
# readable. Grant Viewer/read permission only.
SANITY_API_READ_TOKEN=
# WRITE token: used by the form endpoints to create documents and upload
# resume assets. Needs create + asset-upload permission.
SANITY_API_WRITE_TOKEN=

# ─── Contact form email (nodemailer / SMTP) ─────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# For Gmail this is an App Password, not the account password.
SMTP_PASS=
# Where contact-form notifications are delivered.
COMPANY_EMAIL=

# ─── Careers form email (Resend) ────────────────────────────────────────
# All three are optional: without them the application document is still
# created in Sanity, only the email notification is skipped.
RESEND_API_KEY=
CAREERS_FROM_EMAIL=
CAREERS_INBOX_EMAIL=

# ─── Visualizer (Replicate) ─────────────────────────────────────────────
# Powers /api/segment, /api/segment-point, /api/depth, /api/process-surface.
# Every call costs real credit — these routes are rate limited.
REPLICATE_API_TOKEN=
